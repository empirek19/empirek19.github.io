<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>EMPIRE K-19 — Command. Control. Conquer.</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

  <style>
    :root{
      --gold: #8b6c00;
      --black: #0a0a0a;
      --gunmetal: #1e1e1e;
      --silver: #bfbfbf;
      --whitesmoke: #f5f5f5;
      --max-width: 1200px;
    }

    /* Reset */
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%;background:linear-gradient(180deg,var(--black) 0%, #060606 100%);color:var(--whitesmoke);font-family:Poppins,system-ui,Segoe UI,Roboto,Arial}
    a{color:inherit;text-decoration:none}

    /* Layout */
    header{position:fixed;left:0;right:0;top:0;height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;background:linear-gradient(180deg, rgba(10,10,10,0.6), rgba(10,10,10,0.15));backdrop-filter: blur(4px);z-index:60;border-bottom:1px solid rgba(255,255,255,0.02)}
    .brand{display:flex;align-items:center;gap:14px}
    .logo-shell{width:56px;height:56px;border-radius:8px;background:linear-gradient(145deg,var(--gold), #b38600);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(139,108,0,0.09);}
    .logo-text{font-family:Orbitron, sans-serif;font-weight:700;color:var(--black);padding:4px 8px;border-radius:4px;background:linear-gradient(90deg, rgba(255,255,255,0.85), rgba(255,255,255,0.6));font-size:14px}
    nav a{margin-left:18px;font-weight:600;opacity:0.9}

    .container{max-width:var(--max-width);margin:0 auto;padding:120px 28px 80px}

    /* HERO */
    .hero{min-height:75vh;display:grid;grid-template-columns:1fr 420px;align-items:center;gap:40px}
    .hero-left{padding-right:12px}
    .title{font-family:Orbitron, sans-serif;font-size:48px;letter-spacing:1px;color:var(--gold);}
    .tagline{margin-top:12px;font-size:18px;color:rgba(245,245,245,0.9)}
    .cta-row{margin-top:28px;display:flex;gap:12px}
    .btn{padding:12px 18px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;font-weight:600;cursor:pointer}
    .btn--primary{background:linear-gradient(90deg,var(--gold), #b38600);color:var(--black);box-shadow:0 6px 30px rgba(139,108,0,0.12)}

    /* Robot area */
    .hero-right{position:relative;height:420px;display:flex;align-items:center;justify-content:center}
    .stage{width:420px;height:420px;border-radius:12px;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));display:flex;align-items:center;justify-content:center;position:relative;overflow:visible;border:1px solid rgba(255,255,255,0.03)}

    /* robot head (SVG) */
    .robot-head{width:190px;height:190px;transform-origin:center center;transition:transform 0.08s linear}
    .robot-neck{position:absolute;bottom:40px;width:14px;height:36px;background:linear-gradient(90deg,var(--silver), #8b8b8b);border-radius:6px}

    /* news ticker band */
    .ticker-wrap{position:relative;margin-top:40px;height:60px;display:flex;align-items:center;overflow:hidden;background:rgba(255,255,255,0.02);border-top:1px solid rgba(255,255,255,0.02);border-bottom:1px solid rgba(255,255,255,0.02);backdrop-filter: blur(6px);border-radius:6px}
    .ticker{display:inline-flex;align-items:center;gap:28px;padding:14px 10px;white-space:nowrap;animation:scroll 30s linear infinite}
    .flag{font-size:22px;display:inline-block;padding:6px;border-radius:6px}

    @keyframes scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

    /* Sections */
    section.page{padding:60px 0;border-top:1px solid rgba(255,255,255,0.02)}
    .section-title{font-family:Orbitron;font-size:20px;color:var(--gold);margin-bottom:18px}
    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
    .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:20px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}
    .muted{color:rgba(245,245,245,0.7);font-size:14px}

    /* Organisation chart simple */
    .org-chart{display:flex;flex-direction:column;align-items:center;gap:18px}
    .org-level{display:flex;gap:18px}
    .person{padding:12px 18px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);min-width:200px;background:linear-gradient(90deg, rgba(255,255,255,0.01), rgba(255,255,255,0.02));text-align:center}
    .person h4{font-family:Orbitron;margin-bottom:6px;color:var(--gold)}

    /* News cards */
    .news-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}

    /* Explore content */
    .values{display:flex;gap:12px;flex-wrap:wrap}
    .value-pill{padding:10px 14px;border-radius:999px;border:1px solid rgba(255,255,255,0.03);background:rgba(255,255,255,0.01);font-weight:600}

    /* Contact form */
    .contact-grid{display:grid;grid-template-columns:1fr 360px;gap:18px}
    label{display:block;font-size:13px;margin-bottom:6px}
    input,textarea,select{width:100%;padding:12px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:var(--whitesmoke)}
    textarea{min-height:160px}
    .form-actions{text-align:right;margin-top:12px}

    /* Utilities */
    .center{text-align:center}

    footer{margin-top:60px;padding:28px;color:rgba(245,245,245,0.7);border-top:1px solid rgba(255,255,255,0.02)}

    /* Responsive */
    @media(max-width:980px){.hero{grid-template-columns:1fr;}.hero-right{order:-1;margin-bottom:30px}.grid{grid-template-columns:1fr}.news-list{grid-template-columns:1fr 1fr}.contact-grid{grid-template-columns:1fr}.logo-text{display:none}}

  </style>
</head>
