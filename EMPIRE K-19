  <script>
    // Smooth scroll helper
    function scrollToSection(id){document.getElementById(id).scrollIntoView({behavior:'smooth',block:'start'})}

    // Open mailto (simple)
    function openMail(addr){window.location.href = 'mailto:'+addr}

    // Contact form handler: builds mailto for static deploy (best-effort). For real usage, wire a backend.
    function submitForm(e){
      e.preventDefault();
      const name = document.getElementById('name').value.trim();
      const email = document.getElementById('email').value.trim();
      const type = document.getElementById('type').value;
      const message = document.getElementById('message').value.trim();
      const subject = encodeURIComponent('EMPIRE K-19 Inquiry — ' + type);
      const body = encodeURIComponent('Name: '+name+'\nEmail: '+email+'\nType: '+type+'\n\n'+message);
      // Use mailto as static fallback
      window.location.href = 'mailto:contact@empirek19.com?subject='+subject+'&body='+body;
    }

    // Robot head pupil tracking: rotate the head and move pupil slightly toward cursor
    (function(){
      const head = document.querySelector('.robot-head');
      const pupil = document.getElementById('pupil');
      if(!head) return;
      const stage = document.querySelector('.stage');
      stage.addEventListener('mousemove', function(e){
        const rect = stage.getBoundingClientRect();
        const cx = rect.left + rect.width/2;
        const cy = rect.top + rect.height/2 - 20; // center of head area
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const angle = Math.atan2(dy,dx) * 180 / Math.PI;
        head.style.transform = `rotate(${angle * 0.14}deg)`; // subtle rotation

        // Move pupil within small bounds
        const px = (dx/rect.width) * 14; const py = (dy/rect.height) * 10;
        pupil.setAttribute('cx', 100 + px);
        pupil.setAttribute('cy', 80 + py);
      });

      // Return to neutral when cursor leaves
      stage.addEventListener('mouseleave', function(){
        head.style.transform = 'rotate(0deg)';
        pupil.setAttribute('cx', 100);
        pupil.setAttribute('cy', 80);
      });
    })();

    // Simple search box (filter visible sections) - add a search in header if you want
    function filterSections(q){
      q = q.trim().toLowerCase();
      if(!q){document.querySelectorAll('section.page').forEach(s=>s.style.display='block');return}
      document.querySelectorAll('section.page').forEach(s=>{
        const text = s.innerText.toLowerCase();
        s.style.display = text.indexOf(q) !== -1 ? 'block' : 'none';
      });
    }

    // Accessibility: keyboard jump to sections
    document.addEventListener('keydown', function(e){
      if(e.key === '1') scrollToSection('home');
      if(e.key === '2') scrollToSection('services');
      if(e.key === '3') scrollToSection('news');
    });

  </script>
